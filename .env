# Public IP or domain of this server (curl -4 ifconfig.me)
WG_HOST=🚨YOUR_SERVER_IP
# VPN UDP port: better a random one (20000-60000) than the default 51820
WG_PORT=51820
# Web UI TCP port
PORT=51821

# Empty = random password, printed once on first start: docker compose logs | grep "Web UI password"
# Own password: docker run --rm ghcr.io/zongerx/amnezia-wg-easy-3.1 wgpw 'PASSWORD' -> paste its output here
PASSWORD_HASH=

# en, ua, ru, tr, no, pl, fr, de, ca, es, ko, vi, nl, is, pt, chs, cht, it, th, hi
LANG=en
# Interface inside the container, keep eth0
WG_DEVICE=eth0
WG_DEFAULT_ADDRESS=10.8.0.x
WG_DEFAULT_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
DICEBEAR_TYPE=bottts
USE_GRAVATAR=true

# AmneziaWG parameters for the first start: 3.1, 2.0 or 1.0 (later edited in the Web UI)
AWG_PROFILE=3.1

# Image tag, default: latest
#IMAGE_TAG=dev
