# Quick start: set WG_HOST and WG_PORT below, then `docker compose up -d`.
# Быстрый старт: заполните WG_HOST и WG_PORT ниже, затем `docker compose up -d`.

# Public IP or domain of this server. Find the IP: curl -4 ifconfig.me
# Публичный IP или домен сервера. Узнать IP: curl -4 ifconfig.me
WG_HOST=🚨YOUR_SERVER_IP

# Web UI password. Empty: a random password is generated on first start and printed ONCE
# in the container log: docker compose logs | grep "Web UI password"
# Your own password instead (prints the PASSWORD_HASH='...' line to put here, keep the single quotes):
#   docker run --rm ghcr.io/zongerx/amnezia-wg-easy-3.1 wgpw 'YOUR_PASSWORD'
# Пароль веб-интерфейса. Если пусто — при первом запуске генерируется случайный пароль и ОДИН раз
# выводится в лог контейнера: docker compose logs | grep "Web UI password"
# Свой пароль — команда выше выведет строку PASSWORD_HASH='...', вставьте её сюда (с одинарными кавычками).
PASSWORD_HASH=

# VPN port (UDP). Use a random one, e.g. 20000-60000: the default 51820 is the first one scanners and DPI check.
# Порт VPN (UDP). Лучше случайный, например 20000–60000: стандартный 51820 проверяют первым.
WG_PORT=51820
# Web UI port (TCP) / порт веб-интерфейса (TCP)
PORT=51821

# (Supports: en, ua, ru, tr, no, pl, fr, de, ca, es, ko, vi, nl, is, pt, chs, cht, it, th, hi)
LANG=en
# Network interface inside the container, keep eth0 / Интерфейс внутри контейнера, оставьте eth0
WG_DEVICE=eth0
WG_DEFAULT_ADDRESS=10.8.0.x
WG_DEFAULT_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
DICEBEAR_TYPE=bottts
USE_GRAVATAR=true

# AmneziaWG parameters generated on first start: 3.1, 2.0 or 1.0 (later edited in the Web UI)
# Профиль параметров AmneziaWG при первом запуске: 3.1, 2.0 или 1.0 (потом меняется в веб-интерфейсе)
AWG_PROFILE=3.1

# Image tag. Default: latest (stable). Uncomment only to try a development branch.
# Тег образа. По умолчанию latest (стабильный). Раскомментируйте, только чтобы попробовать ветку разработки.
#IMAGE_TAG=dev
