WG_HOST=🚨YOUR_SERVER_IP
# (Supports: en, ua, ru, tr, no, pl, fr, de, ca, es, ko, vi, nl, is, pt, chs, cht, it, th, hi)
LANG=en
PORT=51821
WG_DEVICE=eth0
WG_PORT=51820
WG_DEFAULT_ADDRESS=10.8.0.x
WG_DEFAULT_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
DICEBEAR_TYPE=bottts
USE_GRAVATAR=true
# AmneziaWG profile generated on first start: 3.1, 2.0 or 1.0
AWG_PROFILE=3.1
# Image tag: latest (master) or a branch name, e.g. dev
IMAGE_TAG=latest